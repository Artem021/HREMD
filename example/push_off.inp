variable N equal 1000											# number of MD steps to be performed
variable alpha equal ramp(0.0,1.0)								# The ramp(a0,a) function linearly interpolates alpha values ​​over the interval (0,N)
variable S equal 999999
variable T equal 600
variable d string P0_init_SI.lmps								# update this line with path to your data file
variable r string pushoff.restart
variable t string pushoff.xyz


units real
atom_style full
timestep 2.0
dimension 3
boundary p p p
pair_style lj/cut/coul/long/soft 1.0 0.5 10.0 8.0 8.0
bond_style harmonic
angle_style harmonic
dihedral_style harmonic
improper_style umbrella

read_data $d

kspace_style pppm 1.0e-4
kspace_modify gewald 0.001 compute no

dump unwr all custom 10 md_soft.lammpstrj id element xu yu zu
dump_modify unwr element S C Cl H C O O							# update this line with the element names in order they appear in your data file

thermo_style custom time temp pe v_alpha press vol density
thermo 10

fix 1 all nvt temp $T $T 20.0

# uncomment next line to apply softening parameter
# fix 2 all adapt 0 pair lj/cut/coul/long/soft lambda * * v_alpha reset yes scale yes

run $N

