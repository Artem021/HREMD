variable N equal 2500
variable alpha equal 0.0
variable S equal 999999
variable T equal 273.15
variable d string binary.restart
variable r string binary.restart
variable t string traj.xyz

read_restart $d

kspace_style     pppm 1.0e-4
kspace_modify gewald 0.001 compute no

neighbor         2.0 bin
neigh_modify     delay 10 every 1 check yes once no

thermo_style     custom time temp pe ke press vol density
thermo           10

fix               1 all nvt temp $T $T 20.0

dump DUMPFILE all xyz 1 $t
dump_modify DUMPFILE element C N C C H C H C O H C H C H H C H H H O


fix 2 all adapt 0 pair lj/cut/coul/long/soft lambda * * v_alpha reset no scale yes

run          $N

write_restart $r